#!/usr/bin/python3 -I
"""Privilegierter Helfer für ROG Fan Control (wird per pkexec gestartet).

Befehle:
  save-config            JSON auf stdin -> prüfen, speichern, aktives Profil anwenden
  fullspeed FAN on|off   Lüfter (cpu|gpu|mid) auf Vollgas / Automatik
  capture-factory        Werkskurven des aktiven Profils neu einlesen
  set-profile PROFIL     platform_profile direkt setzen (Fallback ohne PowerProfiles-Dienst)
  enable-service         Hintergrunddienst aktivieren und starten
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import rogfan_hw as hw  # noqa: E402


def fail(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def main(argv):
    if os.geteuid() != 0:
        fail("Der Helfer muss als root laufen (pkexec).")
    if not argv:
        fail(__doc__)
    cmd, args = argv[0], argv[1:]

    if cmd == "save-config":
        raw = sys.stdin.read(hw.MAX_CONFIG_BYTES + 1)
        if len(raw) > hw.MAX_CONFIG_BYTES:
            fail("Konfiguration ist zu groß.")
        try:
            cfg = hw.validate_config(json.loads(raw))
        except (ValueError, json.JSONDecodeError) as e:
            fail(f"Ungültige Konfiguration: {e}")
        hw.save_config(cfg)
        with hw.hw_lock():
            errors = hw.apply_profile(cfg, hw.read_profile())
        print(json.dumps({"ok": not errors, "errors": errors}))
        sys.exit(2 if errors else 0)

    if cmd == "fullspeed":
        if len(args) != 2 or args[0] not in hw.FANS or args[1] not in ("on", "off"):
            fail("Aufruf: fullspeed cpu|gpu|mid on|off")
        with hw.hw_lock():
            try:
                hw.set_fullspeed(args[0], args[1] == "on")
            except OSError as e:
                fail(f"Konnte Lüftermodus nicht setzen: {e}")
        return

    if cmd == "capture-factory":
        with hw.hw_lock():
            prof = hw.read_profile()
            hw.capture_factory(prof)
            errors = hw.apply_profile(hw.load_config(), prof)
        if errors:
            fail("\n".join(errors), 2)
        return

    if cmd == "set-profile":
        if len(args) != 1 or args[0] not in hw.read_profile_choices():
            fail("Unbekanntes Profil.")
        try:
            hw._write(hw.PLATFORM_PROFILE, args[0])
        except OSError as e:
            fail(f"Konnte Profil nicht setzen: {e}")
        return

    if cmd == "enable-service":
        r = subprocess.run(["systemctl", "enable", "--now", hw.SERVICE],
                           capture_output=True, text=True)
        if r.returncode:
            fail(r.stderr.strip() or "systemctl fehlgeschlagen")
        return

    fail(f"Unbekannter Befehl: {cmd}")


if __name__ == "__main__":
    main(sys.argv[1:])
