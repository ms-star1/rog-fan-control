#!/usr/bin/python3 -I
"""Hintergrunddienst: hält eigene Lüfterkurven und Leistungslimits aktiv.

* beim Start, nach jeder Konfigurationsänderung und nach jedem Profilwechsel
  (GNOME-Energiemodus, Fn+F5, tuned) werden Kurven und Limits angewendet;
* bei jedem Profilwechsel werden vorher die Werkskurven des Profils gesichert;
* setzt die Firmware die Kurven zurück (z. B. nach Standby), wird nachgesetzt.
"""
import os
import json
import signal
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import rogfan_hw as hw  # noqa: E402

POLL = 2.0
FIX_COOLDOWN = 10.0

_force = False


def log(msg):
    print(msg, flush=True)


def on_hup(*_):
    global _force
    _force = True


def config_mtime():
    try:
        return os.stat(hw.CONFIG_PATH).st_mtime_ns
    except OSError:
        return None


def apply(cfg, profile, why, capture=False):
    with hw.hw_lock():
        now = hw.read_profile()  # beim Warten auf die Sperre kann sich das Profil geändert haben
        if now != profile and now in cfg["profiles"]:
            profile = now
        if capture:
            try:
                hw.capture_factory(profile)
            except OSError as e:
                log(f"Werkskurven für {profile} nicht lesbar: {e}")
        errors = hw.apply_profile(cfg, profile)
    active = [f for f, c in cfg["profiles"].get(profile, {}).get("curves", {}).items() if c["enabled"]]
    log(f"[{why}] Profil {profile}: eigene Kurven {','.join(active) or 'keine'}"
        + (f" – Fehler: {'; '.join(errors)}" if errors else ""))


def power_sampler():
    """Rechnet die RAPL-Zähler (nur root lesbar) in ein Sekundenmittel um und
    stellt es der App in POWER_PATH bereit. Ein 1-s-Mittel ist zu grob für
    Seitenkanal-Angriffe, für die der Zugriff ursprünglich gesperrt wurde."""
    last_e, last_t = hw.read_rapl_energy()[0], time.monotonic()
    if last_e is None:
        log("Keine RAPL-Zähler gefunden – CPU-Leistung wird nicht angezeigt.")
        return
    while True:
        time.sleep(1.0)
        e, rng = hw.read_rapl_energy()
        t = time.monotonic()
        if e is None:
            continue
        de = e - last_e
        if de < 0 and rng:
            de += rng  # Zählerüberlauf
        watts = de / 1e6 / (t - last_t) if t > last_t else None
        last_e, last_t = e, t
        if watts is None or not 0 <= watts < 1000:
            continue
        try:
            tmp = hw.POWER_PATH + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"time": time.time(), "cpu_w": round(watts, 1)}, f)
            os.chmod(tmp, 0o644)
            os.replace(tmp, hw.POWER_PATH)
        except OSError:
            pass


def main():
    global _force
    signal.signal(signal.SIGHUP, on_hup)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    os.makedirs(hw.RUN_DIR, mode=0o755, exist_ok=True)
    threading.Thread(target=power_sampler, daemon=True).start()

    last_profile = None
    last_mtime = object()
    last_fix = 0.0
    while True:
        profile = hw.read_profile()
        mtime = config_mtime()
        if profile in hw.profiles():
            if profile != last_profile:
                time.sleep(0.5)  # Firmware den Wechsel abschließen lassen
                apply(hw.load_config(), profile,
                      "Start" if last_profile is None else "Profilwechsel", capture=True)
                last_profile, last_mtime = profile, mtime
            elif mtime != last_mtime or _force:
                apply(hw.load_config(), profile, "Konfiguration")
                last_mtime, _force = mtime, False
            elif time.monotonic() - last_fix > FIX_COOLDOWN:
                cfg = hw.load_config()
                if not hw.curves_match(cfg, profile):
                    apply(cfg, profile, "Nachsetzen")
                    last_fix = time.monotonic()
        time.sleep(POLL)


if __name__ == "__main__":
    main()
